{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ContainerArtifact.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "container"
        },
        "format": {
            "$ref": "ContainerFormat.json"
        },
        "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,511}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "entrypoint": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/LaunchArgument"
            },
            "minItems": 1,
            "maxItems": 64
        }
    },
    "required": [
        "kind",
        "format",
        "image",
        "digest",
        "entrypoint"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "$defs": {
        "LaunchArgument": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
        }
    }
}