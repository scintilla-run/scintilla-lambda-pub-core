{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "InvocationError.json",
    "type": "object",
    "properties": {
        "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
        },
        "retryable": {
            "type": "boolean"
        }
    },
    "required": [
        "code",
        "message",
        "retryable"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}