{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/lambda/v1/InvocationResponse.json",
  "title": "InvocationResponse",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "InvocationProtocol.json"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "InvocationSuccess.json"
        },
        {
          "$ref": "InvocationFailure.json"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "invocationId",
    "result"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Scintilla stdio invocation response"
}
