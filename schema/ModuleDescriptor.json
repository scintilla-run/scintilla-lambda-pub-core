{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/lambda/v1/ModuleDescriptor.json",
  "title": "ModuleDescriptor",
  "type": "object",
  "properties": {
    "kind": { "$ref": "ModuleKind.json" },
    "exportName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
    },
    "contextAbi": {
      "type": "string",
      "const": "scintilla.run/context/v1"
    }
  },
  "required": ["kind", "exportName", "contextAbi"],
  "unevaluatedProperties": { "not": {} }
}
