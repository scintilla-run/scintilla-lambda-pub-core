{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/lambda/v1/InvocationFailure.json",
  "title": "InvocationFailure",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "error"
    },
    "error": {
      "$ref": "InvocationError.json"
