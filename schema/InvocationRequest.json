{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scintilla.run/schemas/lambda/v1/InvocationRequest.json",
  "title": "InvocationRequest",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "InvocationProtocol.json"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "traceparent": {
      "type": "string",
      "maxLength": 512
    },
    "payload": {}
  },
  "required": [
    "protocol",
    "invocationId",
    "timeoutMs",
    "payload"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Scintilla stdio invocation request"
}
